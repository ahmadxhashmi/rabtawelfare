# =========================================================================
# RABTA-E-HAYAT - SUPABASE POSTGRESQL CREDENTIALS
# =========================================================================
# 1. Go to https://supabase.com and create a new project (e.g. rabtawelfare)
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste below in VITE_SUPABASE_URL
# 4. Copy "anon / public" API Key and paste below in VITE_SUPABASE_ANON_KEY
# 5. Run the SQL script from "supabase_schema.sql" in Supabase SQL Editor
# =========================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
